{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oath.jeb2-spec.dev/schemas/finding/v0.json",
  "title": "Finding",
  "description": "A specific instance of a Signal firing against a specific Officeholder.",
  "type": "object",
  "required": ["id", "signal_id", "officeholder_id", "producing_filings", "fired_at", "build_hash", "description"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "signal_id": {
      "type": "string",
      "pattern": "^sg:[a-z0-9-]+:v\\d+$"
    },
    "officeholder_id": {
      "type": "string",
      "pattern": "^oh:[a-z]{2}:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "producing_filings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Filing IDs whose rows produced this Finding."
    },
    "producing_rows": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["schema", "id"],
        "additionalProperties": false,
        "properties": {
          "schema": { "type": "string", "enum": ["holding", "transaction"] },
          "id": { "type": "string" }
        }
      }
    },
    "fired_at": { "type": "string", "format": "date-time" },
    "build_hash": {
      "type": "string",
      "description": "SHA-256 of the register at the build that produced this Finding."
    },
    "description": {
      "type": "string",
      "description": "Description text derived from the Signal's template. No verdict language."
    },
    "superseded_by": {
      "type": ["string", "null"],
      "description": "Finding ID that supersedes this one, when a later build corrects it."
    },
    "notes": { "type": ["string", "null"] }
  }
}
